# Bifrost API credentials (from your Bifrost dashboard's API/developer section)
BIFROST_CLIENT_ID=
BIFROST_CLIENT_SECRET=

# The Hell Let Loose server ID this bot should track (UUID from Bifrost)
BIFROST_SERVER_ID=

# Path to the SQLite database file. On Render this should point at the
# mounted persistent disk, e.g. /data/trr-bot.db
DB_PATH=./trr-bot.db
